# Local run logs — regenerated every run, not worth versioning
*.log
scan-output.txt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Never commit credentials
.env
*.token
secrets/

# Uncompressed snapshots — the workflow gzips them before commit
snapshots/*.json

# Generated artifacts and isolated integration runs
reports/
reports-preview/
.local-data/
.test-data/
.pytest_cache/
*.db
*.db-shm
*.db-wal
data/imports/*.json
!data/imports/*.example.json
